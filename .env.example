# YouTube Data API v3 key. Required by the crawl scripts, not by the frontend.
# console.cloud.google.com → APIs & Services → Credentials → API key,
# restricted to "YouTube Data API v3". See docs/setup.md.
YOUTUBE_API_KEY=

# Optional extra keys, up to YOUTUBE_API_KEY9. The crawler spends them in order,
# moving to the next when one runs out, so N keys are N days of crawling in one
# evening. The 10 000 units belong to a Google Cloud **project**, not to a key:
# a second key is only worth adding when it comes from a second project.
# YOUTUBE_API_KEY2=

# Optional. Used only for LLM matching (`pnpm data:match --llm`) and for
# generating domain images (`pnpm data:images --openai`). Everything works
# without it: matching falls back to rules plus manual review, images to the
# procedural SVG generator.
OPENAI_API_KEY=
# OPENAI_CLASSIFY_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# Stop the crawler this far into the 10 000 unit daily quota, leaving a margin.
# Per key, so two keys are 19 000 units a day.
YOUTUBE_QUOTA_CEILING=9500

# Interface language to build. Only `ru` exists so far.
DEFAULT_LANG=ru

# Which repository the frontend links to — "suggest a playlist" opens an issue
# there, "fix this entry" opens the course file. It also decides the
# subdirectory the site is built for, since Pages serves a project site from
# /<repo>/. CI passes this in from GitHub's own context, so it is only needed
# locally, and only if you build for a fork.
# VITE_REPO=fivol/lectorea

# Overrides the subdirectory above. Set it to / when serving from a custom
# domain, where the site sits at the root.
# BASE_PATH=/
