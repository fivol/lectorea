# YouTube Data API v3 key. Required by the crawl scripts, not by the frontend.
# console.cloud.google.com → APIs & Services → Credentials → API key,
# restricted to "YouTube Data API v3". See docs/setup.md.
YOUTUBE_API_KEY=

# Optional extra keys: YOUTUBE_API_KEY2, 3, … with no upper slot. The crawler
# reads whichever numbered slots exist and spends them in order,
# moving to the next when one runs out, so N keys are N days of crawling in one
# evening. The 10 000 units belong to a Google Cloud **project**, not to a key:
# a second key is only worth adding when it comes from a second project.
# YOUTUBE_API_KEY2=

# Optional. Used only for LLM matching (`pnpm data:match --llm`) and for
# generating domain images (`pnpm data:images --openai`). Everything works
# without it: matching falls back to rules plus manual review, images to the
# procedural SVG generator.
OPENAI_API_KEY=
# OPENAI_CLASSIFY_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# Stop the crawler this far into the 10 000 unit daily quota, leaving a margin.
# Per key, so two keys are 19 000 units a day.
YOUTUBE_QUOTA_CEILING=9500

# Interface language to build. Only `ru` exists so far.
DEFAULT_LANG=ru

# Which repository the frontend links to — "suggest a playlist" opens an issue
# there, "fix this entry" opens the course file. It also decides the
# subdirectory the site is built for, since Pages serves a project site from
# /<repo>/. CI passes this in from GitHub's own context, so it is only needed
# locally, and only if you build for a fork.
# VITE_REPO=fivol/lectorea

# Overrides the subdirectory above. Set it to / when serving from a custom
# domain, where the site sits at the root.
# BASE_PATH=/

# The GA4 web stream the built site reports to, as G-XXXXXXXXXX. Empty — the
# default — and the site counts nothing at all: no script is loaded and no
# request is made. CI passes the real one in for this repository only, so a
# fork is silent without editing anything. Nothing in the crawl or the build
# reads it; it reaches the browser and nowhere else. See docs/analytics.md.
# VITE_GA4_ID=

# Set to 1 to report from `pnpm dev` as well, marked as debug traffic. Off by
# default, or an afternoon of work lands in the same reports as the readers.
# VITE_GA4_DEBUG=1

# The Firebase project the optional sync account lives in. All four empty — the
# default — and the site has no accounts at all: the «Синхронизация» section is
# absent from the profile and not a byte of the Firebase SDK is downloaded, which
# is the right default for a fork. Only the deploy that is handed them has sync.
#
# None of these is a secret. A Firebase web config ships inside the bundle by
# construction and is public the moment the site is; what protects a profile is
# the rule in firebase/firestore.rules, which allows a reader their own document
# and nothing else. They are kept out of the repository so that a fork is silent
# by default, not because knowing them buys anything. See docs/sync.md.
#
# console.firebase.google.com → Project settings → Your apps → Web app.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=lectorea.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=lectorea
# VITE_FIREBASE_APP_ID=

# Administrative access to that property, for `pnpm ga4:setup` — a service
# account key at keys/ga4-admin.json. Never committed (keys/ is in .gitignore)
# and never needed by the site or by CI: only by the script that registers the
# custom dimensions a report is read through.
# GA4_KEY_FILE=keys/ga4-admin.json
